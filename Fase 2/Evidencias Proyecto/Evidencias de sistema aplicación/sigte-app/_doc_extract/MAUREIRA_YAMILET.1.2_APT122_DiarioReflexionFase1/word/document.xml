p:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="17580" name="image2.png"/><wp:cNvGraphicFramePr/><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="image2.png"/><pic:cNvPicPr preferRelativeResize="0"/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId8"/><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="393640" cy="444500"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:ln/></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="9088" w:type="dxa"/></w:tcPr><w:p w14:paraId="11D75F5B" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>En esta pauta encontrarás preguntas orientadoras para tu reflexión. Las primeras te ayudarán a recordar las principales competencias aprendidas a lo largo de tu carrera. Las siguientes preguntas, buscan ayudarte a definir tu proyecto APT a partir de tus fortalezas, oportunidades de mejora e intereses profesionales.</w:t></w:r></w:p><w:p w14:paraId="0E71D411" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3FE157E2" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Se sugiere que tengan como material de apoyo las evidencias recolectadas a lo largo de todo el proceso de portafolio, y que revises en el anexo de la guía del estudiante tu malla curricular, y las competencias y unidades de competencia por asignatura.</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="5781A479" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:spacing w:after="0" w:line="240" w:lineRule="auto"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:tbl><w:tblPr><w:tblStyle w:val="a0"/><w:tblW w:w="10057" w:type="dxa"/><w:tblInd w:w="0" w:type="dxa"/><w:tblLayout w:type="fixed"/><w:tblLook w:val="0400" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="10057"/></w:tblGrid><w:tr w:rsidR="00221F7B" w14:paraId="5777E0AA" w14:textId="77777777"><w:tc><w:tcPr><w:tcW w:w="10057" w:type="dxa"/><w:tcBorders><w:top w:val="single" w:sz="6" w:space="0" w:color="CDCDCD"/><w:left w:val="single" w:sz="6" w:space="0" w:color="CDCDCD"/><w:bottom w:val="single" w:sz="6" w:space="0" w:color="CDCDCD"/><w:right w:val="single" w:sz="6" w:space="0" w:color="CDCDCD"/></w:tcBorders><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="238F9C9C" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:spacing w:after="0" w:line="240" w:lineRule="auto"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Puedes responder en cada una de las secciones por pregunta en esta guía y, posteriormente, cargarla en la sección de reflexión de la Fase 1, para retroalimentación de tu docente.</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="2CF2CB5A" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:spacing w:after="0" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="796FFD41" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:spacing w:after="0" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:tbl><w:tblPr><w:tblStyle w:val="a1"/><w:tblW w:w="10076" w:type="dxa"/><w:tblInd w:w="-3" w:type="dxa"/><w:tblBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:left w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:right w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/></w:tblBorders><w:tblLayout w:type="fixed"/><w:tblLook w:val="0400" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="10076"/></w:tblGrid><w:tr w:rsidR="00221F7B" w14:paraId="1BD49605" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="440"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="5853A458" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>1. Revisa la malla de tu carrera, piensa en las asignaturas o certificados de competencias que has cursado hasta ahora. Responde:</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00221F7B" w14:paraId="2B4A9834" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="1663"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="DEEAF6" w:themeFill="accent1" w:themeFillTint="33"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="458BED52" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="241C42C6" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">¿Cuáles son las asignaturas o certificados que más te gustaron y/o se relacionan con tus intereses profesionales? ¿Qué es lo que más te gustó de cada uno? </w:t></w:r></w:p><w:p w14:paraId="6B3A738E" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3C6FEF52" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Dentro de la malla curricular, las asignaturas y certificaciones que más se relacionaron con mis intereses profesionales fueron Inteligencia de Negocios, Análisis y Desarrollo de Modelos de Datos, Ciencia de Datos y el dominio del Inglés Intermedio Alto.</w:t></w:r></w:p><w:p w14:paraId="2D3CE373" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="13EE7145" w14:textId="610004F9" w:rsidR="00221F7B" w:rsidRDefault="4488F0A1"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Lo que más me gusto, partiendo por Inteligencia de Negocio fue el aprender </w:t></w:r><w:r w:rsidR="20D55612" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>cómo</w:t></w:r><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> funciona el proceso de tener muchas fuentes de información y juntarlas para transformarlas en información valiosa que puede ser visualizada. También el Análisis y Desarrollo de Modelos de Datos me gusto porque me hizo comprender el funcionamiento de una base de datos teniendo cientos de datos a miles y como este es el motor de cualquier sistema. La Ciencia de Datos me gusto por </w:t></w:r><w:r w:rsidR="715A31D1" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>cómo</w:t></w:r><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> se pueden encontrar patrones en los datos, jugar con ellos para generar conocimiento útil a partir de un gran volumen de datos y convertirlos en información. Finalmente, Inglés Intermedio Alto como una gran herramienta para la carrera de informática que puede abrir puertas más allá de nuestro país y además mucha de la documentación técnica se encuentra en este </w:t></w:r><w:r w:rsidR="5DDAE3B3" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>idioma</w:t></w:r><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="3D7C2A46" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5F6EA0D6" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="321D10AD" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>A partir de las certificaciones que obtienes a lo largo de la carrera ¿Existe valor en la o las certificaciones obtenidas? ¿Por qué?</w:t></w:r></w:p><w:p w14:paraId="20159C02" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6A2D1EC8" w14:textId="63A55E30" w:rsidR="200E92F0" w:rsidRDefault="200E92F0" w:rsidP="72A62B9F"><w:pPr><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Sí, creo que las certificaciones sirven harto como herramientas base que podemos usar cuando nos toca prestar nuestros conocimientos como servicio. El mundo tecnológico avanza rapidísimo y probablemente lo que aprendimos dentro de la carrera ya está obsoleto, pero lo que de verdad nos </w:t></w:r><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:lastRenderedPageBreak/><w:t>queda son las metodologías y la base para saber cómo hacer las cosas. Siempre se necesita tener una base firme para seguir expandiéndonos</w:t></w:r><w:r w:rsidR="7940FCF8" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> profesionalmente, así creo que funciona</w:t></w:r><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">, especialmente en las áreas que a uno le apasionan, así que veo las certificaciones que nos dio Duoc como ese punto de partida </w:t></w:r><w:r w:rsidR="5A25FC5A" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>donde se puede</w:t></w:r><w:r w:rsidR="4F6B408E" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> seguir especializando</w:t></w:r><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="49A71E84" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:color w:val="1F4E79"/></w:rPr></w:pPr></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="738CDC51" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:spacing w:after="0" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:tbl><w:tblPr><w:tblW w:w="10076" w:type="dxa"/><w:tblInd w:w="-3" w:type="dxa"/><w:tblBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:left w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:right w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/></w:tblBorders><w:tblLayout w:type="fixed"/><w:tblLook w:val="0400" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="10076"/></w:tblGrid><w:tr w:rsidR="00221F7B" w14:paraId="092A3480" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="440"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="7DED06C8" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">2. Revisa las competencias y unidades de competencias correspondientes a cada asignatura de la malla de tu carrera. Marca en </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="385623"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>verde</w:t></w:r><w:r><w:rPr><w:color w:val="385623"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">las competencias o unidades de competencia que consideras son tus </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="385623"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>fortalezas</w:t></w:r><w:r><w:rPr><w:color w:val="385623"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">y en </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="FF0000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>rojo</w:t></w:r><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> las que requieren ser fortalecidas. A partir de este ejercicio responde:</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00221F7B" w14:paraId="6E42EA17" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="440"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="DEEAF6" w:themeFill="accent1" w:themeFillTint="33"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="332CC022" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="10374CB2" w14:textId="76C1B343" w:rsidR="00221F7B" w:rsidRDefault="4488F0A1" w:rsidP="008A2B31"><w:pPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="000000" w:themeColor="text1"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">¿Cuáles consideras que tienes más desarrolladas y te sientes más seguro aplicando? ¿En cuáles te sientes más débil y requieren ser fortalecidas? </w:t></w:r></w:p><w:p w14:paraId="7A000814" w14:textId="0006FE11" w:rsidR="00221F7B" w:rsidRPr="008A2B31" w:rsidRDefault="30690DE4" w:rsidP="008A2B31"><w:pPr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Me siento mucho más segura en áreas donde tenga que manejar y manipular datos, yendo hacia mi lado favorito que es la ciencia de datos, hacer todo ese proceso y poder crear modelos analíticos. También me siento cómoda con la documentación orientada a la gestión de proyectos, además de entender los procesos de negocio, mapearlos y entender dónde se necesitan mejoras. Por el contrario, lo que más me cuesta es el desarrollo de software, tanto </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>frontend</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> como </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>backend</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> y todo lo que conlleva llevar un proyecto a producción, a veces me cuesta el pensar como traduci</w:t></w:r><w:r w:rsidR="3A41F0B1" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>r</w:t></w:r><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> lo que necesito a un código específico, aunque sé que es pura práctica. En ciberseguridad también me siento débil, pero más que nada porque no es un área que me llame la atención</w:t></w:r><w:r w:rsidR="1B820C11" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>conozco los conceptos generales, pero no es un mundo en el que quiera profundizar. Las bases de datos me fascinan, pero reconozco que necesito practicar para recordar la sintaxis, ya que los últimos semestres los pasé más enfocada en gestión y documentación que en tirar código puro, aunque la parte conceptual la tengo clara.</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="72A62B9F" w14:paraId="09A1D5B1" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="440"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="DEEAF6" w:themeFill="accent1" w:themeFillTint="33"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="60EEEA70" w14:textId="3F54FB0D" w:rsidR="72A62B9F" w:rsidRDefault="72A62B9F" w:rsidP="72A62B9F"><w:pPr><w:jc w:val="both"/><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="181B53E4" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:spacing w:after="0" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:color w:val="595959"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0AE5AB1A" w14:textId="13F1D474" w:rsidR="00221F7B" w:rsidRDefault="00221F7B" w:rsidP="72A62B9F"><w:pPr><w:spacing w:after="0" w:line="360" w:lineRule="auto"/></w:pPr></w:p><w:tbl><w:tblPr><w:tblW w:w="10076" w:type="dxa"/><w:tblInd w:w="-3" w:type="dxa"/><w:tblBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:left w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:right w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="BFBFBF" w:themeColor="background1" w:themeShade="BF"/></w:tblBorders><w:tblLayout w:type="fixed"/><w:tblLook w:val="0400" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="10076"/></w:tblGrid><w:tr w:rsidR="00221F7B" w14:paraId="198A8836" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="440"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="27E1B932" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>3. A partir de las respuestas anteriores y el perfil de egreso de tu carrera (competencias), responde las siguientes preguntas:</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00221F7B" w14:paraId="7DE5E496" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="440"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="DEEAF6" w:themeFill="accent1" w:themeFillTint="33"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="7298394F" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="54DB86A8" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="4488F0A1" w:rsidP="72A62B9F"><w:pPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="000000" w:themeColor="text1"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>¿Cuáles son tus principales intereses profesionales? ¿Hay alguna área de desempeño que te interese más?</w:t></w:r></w:p><w:p w14:paraId="04C9B7B9" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="38E644AA" w14:textId="4FD01F0F" w:rsidR="3C6C936E" w:rsidRDefault="3C6C936E" w:rsidP="72A62B9F"><w:pPr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:lastRenderedPageBreak/><w:t>Mis principales intereses profesionales apuntan de lleno al análisis de datos, la inteligencia de negocios y la ciencia de datos. Me gusta todo el ciclo de la información: transformar datos crudos en conocimiento útil para que las organizaciones puedan tomar decisiones informadas.</w:t></w:r></w:p><w:p w14:paraId="6508E00E" w14:textId="77777777" w:rsidR="008A2B31" w:rsidRDefault="008A2B31" w:rsidP="72A62B9F"><w:pPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="21D2C924" w14:textId="208853FA" w:rsidR="00221F7B" w:rsidRDefault="4488F0A1" w:rsidP="008A2B31"><w:pPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="000000" w:themeColor="text1"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>¿Cuáles son las principales competencias que se relacionan con tus intereses profesionales? ¿Hay alguna de ellas que sientas que requieres especialmente fortalecer?</w:t></w:r></w:p><w:p w14:paraId="2E7B275F" w14:textId="163DB435" w:rsidR="00221F7B" w:rsidRDefault="02A2F3CB"><w:pPr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Las competencias que más se conectan son la construcción de modelos de datos, la manipulación de información y la creación de soluciones basadas en datos. Lo que siento que debo fortalecer más es la programación de rutinas de datos un poco más complejas y cómo integrar todo eso dentro de una arquitectura de software completa.</w:t></w:r></w:p><w:p w14:paraId="2A87093D" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="197A3943" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="4488F0A1" w:rsidP="72A62B9F"><w:pPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="000000" w:themeColor="text1"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>¿Cómo te gustaría que fuera tu escenario laboral en 5 años más? ¿Qué te gustaría estar haciendo?</w:t></w:r></w:p><w:p w14:paraId="65E25817" w14:textId="66883BE9" w:rsidR="00221F7B" w:rsidRDefault="5AE7653C" w:rsidP="72A62B9F"><w:pPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">En 5 años más me gustaría tener un trabajo estable en áreas que me interesen, ese es el ideal, pero de no ser el caso, quiero tener trabajo que me pueda permitir vivir, también espero que para ese tiempo pueda lograr tener experiencia en lo que estudie.  </w:t></w:r></w:p><w:p w14:paraId="00F3797D" w14:textId="7792D3A1" w:rsidR="00221F7B" w:rsidRDefault="5AE7653C" w:rsidP="72A62B9F"><w:pPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Dentro de los trabajos ideales, se encuentra algún banco, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>retail</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>, salud, pero honestamente, cualquier cosa es bienvenida</w:t></w:r><w:r w:rsidR="71DC37AA" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> para mi futura yo</w:t></w:r><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="1454379B" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:color w:val="1F4E79"/></w:rPr></w:pPr></w:p></w:tc></w:tr><w:tr w:rsidR="72A62B9F" w14:paraId="6E6EBBBE" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="440"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="DEEAF6" w:themeFill="accent1" w:themeFillTint="33"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="7CE7EEF4" w14:textId="2F309621" w:rsidR="72A62B9F" w:rsidRDefault="72A62B9F" w:rsidP="72A62B9F"><w:pPr><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="777F3FEE" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:spacing w:after="0" w:line="360" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:color w:val="595959"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:tbl><w:tblPr><w:tblStyle w:val="a4"/><w:tblW w:w="10076" w:type="dxa"/><w:tblInd w:w="-3" w:type="dxa"/><w:tblBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:left w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:right w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="BFBFBF"/></w:tblBorders><w:tblLayout w:type="fixed"/><w:tblLook w:val="0400" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="10076"/></w:tblGrid><w:tr w:rsidR="00221F7B" w14:paraId="4DC2E1C7" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="440"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="3EAEAA2A" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="008F235D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Century Gothic" w:eastAsia="Century Gothic" w:hAnsi="Century Gothic" w:cs="Century Gothic"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:bookmarkStart w:id="0" w:name="_heading=h.3f644kczpgs2" w:colFirst="0" w:colLast="0"/><w:bookmarkEnd w:id="0"/><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">4. Finalmente, piensa en el proyecto que desarrollarás en APT y responde a las siguientes preguntas: </w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00221F7B" w14:paraId="5DD6C085" w14:textId="77777777" w:rsidTr="72A62B9F"><w:trPr><w:trHeight w:val="440"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="10076" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="DEEAF6" w:themeFill="accent1" w:themeFillTint="33"/><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="485C64F0" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1B991645" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="4488F0A1" w:rsidP="008A2B31"><w:pPr><w:pBdr><w:top w:val="nil"/><w:left w:val="nil"/><w:bottom w:val="nil"/><w:right w:val="nil"/><w:between w:val="nil"/></w:pBdr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:spacing w:after="160" w:line="259" w:lineRule="auto"/><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="000000" w:themeColor="text1"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Los Proyectos APT que ya habías diseñado como plan de trabajo en el curso anterior, ¿se relacionan con tus proyecciones profesionales actuales? ¿cuál se relaciona más? ¿Requiere ajuste?</w:t></w:r></w:p><w:p w14:paraId="5AF808B1" w14:textId="77777777" w:rsidR="00221F7B" w:rsidRDefault="00221F7B"><w:pPr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="78724DE8" w14:textId="557A47EC" w:rsidR="00221F7B" w:rsidRDefault="04796105"><w:pPr><w:tabs><w:tab w:val="left" w:pos="454"/></w:tabs><w:jc w:val="both"/><w:rPr><w:color w:val="767171"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Dentro de los que se relacionan</w:t></w:r><w:r w:rsidR="09B19ACA" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> con mis intereses en el proyecto actual es </w:t></w:r><w:r w:rsidR="36CEB5FE" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">totalmente relacionado. El proyecto se enfoca en la gestión y trazabilidad del servicio de esterilización del Hospital San José de Melipilla y siento que calza muy bien con mis intereses, porque me permite meterme de lleno en el análisis de procesos, el modelado de bases de datos y la estructuración de flujos de información centralizada, aportando además toda la parte analítica a través de reportes y estadísticas para el área clínica. No requiere ningún ajuste mayor porque equilibra muy bien la gestión con el desarrollo tecnológico. </w:t></w:r><w:r w:rsidR="78911983" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Además,</w:t></w:r><w:r w:rsidR="36CEB5FE" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> un punto un poco apa</w:t></w:r><w:r w:rsidR="105EB9EE" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>rte</w:t></w:r><w:r w:rsidR="7C01B91D" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>, me interesan los proyectos donde se pueda hacer un impacto positivo en la vida cotidiana de las personas y mejorar de alguna manera</w:t></w:r><w:r w:rsidR="301A721D" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">, creo </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="301A721D" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>que</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="301A721D" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> si </w:t></w:r><w:r w:rsidR="11C1AAD8" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>algún</w:t></w:r><w:r w:rsidR="301A721D" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="2DC75AA3" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>día</w:t></w:r><w:r w:rsidR="301A721D" w:rsidRPr="72A62B9F"><w:rPr><w:color w:val="767171" w:themeColor="background2" w:themeShade="80"/><w:sz w:val